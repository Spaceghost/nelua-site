#syntax 'syntax.bendjs'
## pragmas.noentrypoint = true
## pragmas.nogc = true
## pragmas.nochecks = true
## pragmas.nocstaticassert = true

-- The host supplies this rule as a Bend-generated JavaScript function.
bendjs (survives) do
  local function survives(alive: uint32, neighbors: uint32): uint32
    if neighbors == 3_u32 then
      return 1_u32
    elseif neighbors == 2_u32 then
      return alive
    else
      return 0_u32
    end
  end
end

-- The guest computes one row from three 16-bit rows on a wrapping board.
local function next_row(above: uint32, row: uint32, below: uint32): uint32
    <cexport, codename 'next_row'>
  -- Column totals slide across the row. Append column zero to wrap on the right.
  local left = ((above >> 15) & 1) + ((row >> 15) & 1) + ((below >> 15) & 1)
  local middle = (above & 1) + (row & 1) + (below & 1)
  above = (above & 0xffff) | ((above & 1) << 16)
  row = (row & 0xffff) | ((row & 1) << 16)
  below = (below & 0xffff) | ((below & 1) << 16)
  local next_bits: uint32 = 0
  for x: uint32 = 0, < 16 do
    local alive = row & 1
    above, row, below = above >> 1, row >> 1, below >> 1
    local right = (above & 1) + (row & 1) + (below & 1)
    next_bits = next_bits | (survives(alive, left + middle + right - alive) << x)
    left, middle = middle, right
  end
  return next_bits
end
