						" as glibc prints x87 long doubles), "
						<code> "expr"
						" (arbitrary-precision arithmetic, glibc's regex messages) "
						<code> "factor"
						" (any length, with GNU's output order through pipes), "
						<code> "cmp"
						" (diffutils), "
						<code> "od"
						", "
						<code> "sort"
						" (keys, -R, --debug, merge), "
						<code> "xargs"
						" (findutils, -P included) "
