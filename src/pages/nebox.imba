export const title = "nebox · a toybox-style userland in Nelua on nelibc · spacegho.st/nelua"
export const description = "nebox is a toybox/busybox-style multicall binary written in Nelua and linked against nelibc's standalone profile: 104 applets, including an interactive POSIX shell, in one static x86-64 executable with no host libc, checked against GNU coreutils, gawk and dash by 1,393 conformance cases."

export def body
